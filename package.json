{
  "name": "dsh-semantic-copilot",
  "version": "0.1.1",
  "description": "DSH 输入框语义增强：把当前草稿交给当前模型改写为更清晰、更具体的提示词，一键替换原文，再次点击可还原。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./prompt": {
      "default": "./prompt.js"
    },
    "./locale/*": "./locale/*",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "prompt.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "test"
  ],
  "scripts": {
    "test": "node --test test/prompt.test.mjs test/enhancer.test.mjs test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "prompt",
    "enhance",
    "composer",
    "semantic",
    "提示词",
    "语义增强"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
